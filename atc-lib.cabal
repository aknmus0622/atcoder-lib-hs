cabal-version:      2.4
name:               atc-lib
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:     src
    exposed-modules:    Atc
                      , Atc.BFS
                      , Atc.DFS
                      , Atc.Debug
                      , Atc.DP
                      , Atc.IO
                      , Atc.Graph
                      , Atc.Graph.Functional
                      , Atc.Grid
                      , Atc.Math
                      , Atc.Memo
                      , Atc.TwoPointers
                      , Atc.UnionFind
    build-depends:      base >=4.17 && <5
                      , bytestring
                      , containers
                      , primitive
                      , vector
                      , vector-algorithms
    default-language:   Haskell2010
    ghc-options:        -Wall -Wno-unused-top-binds
