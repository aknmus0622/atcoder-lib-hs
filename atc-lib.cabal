cabal-version:      2.4
name:               atc-lib
version:            0.1.0.0
build-type:         Simple

library
    hs-source-dirs:     src
    exposed-modules:    Atc
                      , Atc.BFS
                      , Atc.BinarySearch
                      , Atc.Convolution
                      , Atc.DFS
                      , Atc.Debug
                      , Atc.DP
                      , Atc.Fenwick
                      , Atc.Graph.Flow
                      , Atc.Graph.Tree
                      , Atc.IO
                      , Atc.Graph
                      , Atc.Graph.Cycle
                      , Atc.Graph.Functional
                      , Atc.Grid
                      , Atc.JumpTable
                      , Atc.Math
                      , Atc.Memo
                      , Atc.ModInt
                      , Atc.MonoStack
                      , Atc.SegTree
                      , Atc.Sequence
                      , Atc.SparseTable
                      , Atc.String
                      , Atc.TwoPointers
                      , Atc.UnionFind
    build-depends:      base >=4.17 && <5
                      , bytestring
                      , containers
                      , primitive
                      , vector
                      , vector-algorithms
    default-language:   Haskell2010
    ghc-options:        -Wall -Wno-unused-top-binds
